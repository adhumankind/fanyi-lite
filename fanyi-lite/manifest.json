{
  "manifest_version": 3,
  "name": "宇宙无敌超级霹雳便捷的网页翻译工具",
  "description": "一键将整个网页翻译成中文，支持双语对照阅读。作者：阿帝",
  "version": "0.8.9",
  "author": "阿帝",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "宇宙无敌超级霹雳便捷的网页翻译工具 (Alt+1)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-translate": {
      "suggested_key": { "default": "Alt+1" },
      "description": "切换全文翻译"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
